# Browser-visible Naver Maps application ID. Register localhost:4173 and mohai.noado.kr.
NAVER_MAP_CLIENT_ID=axlm0kzsi4
# Server only, never sent to the browser.
NAVER_MAP_CLIENT_SECRET=
# Weather free endpoint: local non-commercial evaluation ONLY.
OPEN_METEO_PREVIEW=false
# For commercial use, configure the paid customer API and key after authorization.
OPEN_METEO_API_KEY=
PORT=4173

# Server/build-only data.go.kr Decoding key; never NEXT_PUBLIC/VITE/public.
TOUR_API_SERVICE_KEY=

# Server-only NAVER API HUB credentials; distinct from Maps credentials.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
