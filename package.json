{
  "name": "mohai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MOHAI — a source-aware local day planner for Goyang",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.mjs",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "ontology:pilot": "node scripts/ontology-pilot.mjs",
    "ontology:check": "node scripts/ontology-pilot.mjs --check"
  },
  "engines": {
    "node": "24.x"
  }
}
